# Companies House Public Data API key
# Get yours at: https://developer-specs.company-information.service.gov.uk/
CH_API_KEY=your-companies-house-api-key-here

# Database
POSTGRES_DB=kyc
POSTGRES_USER=kyc
POSTGRES_PASSWORD=kyc_secret
DATABASE_URL=postgresql+asyncpg://kyc:kyc_secret@localhost:5432/kyc

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# First admin user (created on first startup if no users exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-on-first-login

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
